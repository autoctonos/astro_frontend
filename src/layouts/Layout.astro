---
import "../styles/global.css";
import Footer from "@/components/Footer";
const { title = "Autóctonos", description, image } = Astro.props as {
  title?: string;
  description?: string;
  image?: string;
};
import CartDrawer from "@/components/cart-drawer";

---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Ícono de pestaña: emblema de Autóctonos (public/favicon.svg, recortado del logo). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#386641" />
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
  </head>
  <body class="relative flex min-h-screen flex-col bg-custom-cream">
    <main class="container mx-auto max-w-7xl flex-grow px-6">
      <slot />
      <CartDrawer client:load />
    </main>
    <Footer client:idle />
  </body>
</html>
